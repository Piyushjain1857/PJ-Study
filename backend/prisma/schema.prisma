// PJ Study Database Architecture Schema
// PostgreSQL + Prisma ORM Relational Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  STUDENT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum NoteStatus {
  DRAFT
  PENDING
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  PUBLISHED
  UNPUBLISHED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReviewReportReason {
  SPAM
  HARASSMENT
  OFFENSIVE
  MISLEADING
  OTHER
}

enum ReviewReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

// =============================================================================
// CORE MODELS
// =============================================================================

/// User model represents a registered student, moderator, or administrator account.
model User {
  id               String      @id @default(uuid())
  name             String      @db.VarChar(120)
  email            String      @unique @db.VarChar(255)
  passwordHash     String      @map("password_hash") @db.VarChar(255)
  avatarUrl        String?     @map("avatar_url") @db.VarChar(1024)
  bio              String?     @db.Text
  university       String?     @db.VarChar(150)
  universityId     String?     @map("university_id")
  courseId         String?     @map("course_id")
  semester         Int?        @db.SmallInt
  publicProfileEnabled   Boolean @default(true) @map("public_profile_enabled")
  showAcademicInfo       Boolean @default(true) @map("show_academic_info")
  showBio                Boolean @default(true) @map("show_bio")
  showContributionStats  Boolean @default(true) @map("show_contribution_stats")
  role             Role        @default(STUDENT)
  isEmailVerified  Boolean     @default(false) @map("is_email_verified")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relationships
  universityRef           University?              @relation(fields: [universityId], references: [id], onDelete: SetNull)
  course                  Course?                  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  notes                   Note[]                   @relation("UserNotes")
  bookmarks               Bookmark[]
  collections             StudyCollection[]
  downloadHistory         DownloadHistory[]
  viewHistory             NoteViewHistory[]
  reviews                 Review[]
  helpfulVotes            ReviewHelpfulVote[]
  reportsSubmitted        Report[]                 @relation("ReportedByUser")
  reportsReviewed         Report[]                 @relation("ReviewedByUser")
  reviewReportsSubmitted  ReviewReport[]           @relation("ReviewReporter")
  reviewReportsReviewed   ReviewReport[]           @relation("ReviewReportModerator")
  auditLogs               AuditLog[]
  refreshSessions         RefreshSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  emailDeliveryLogs       EmailDeliveryLog[]
  announcementsCreated    Announcement[]           @relation("AnnouncementAuthor")

  @@index([role])
  @@index([isActive])
  @@index([role, isActive])
  @@index([courseId])
  @@index([universityId])
  @@map("users")
}

/// University represents an academic institution (e.g. Stanford University, Delhi University).
model University {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(200)
  slug        String    @unique @db.VarChar(200)
  shortName   String?   @map("short_name") @db.VarChar(50)
  code        String?   @unique @db.VarChar(50)
  description String?   @db.Text
  website     String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relationships
  schools     School[]
  courses     Course[]
  users       User[]
  notes       Note[]

  @@index([isActive])
  @@map("universities")
}

/// School represents an academic division or faculty within a university (e.g. School of Engineering).
model School {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  name         String     @db.VarChar(200)
  slug         String     @db.VarChar(200)
  code         String?    @db.VarChar(50)
  description  String?    @db.Text
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relationships
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courses      Course[]
  notes        Note[]

  @@unique([universityId, slug], name: "university_school_slug_unique")
  @@index([universityId])
  @@index([isActive])
  @@map("schools")
}

/// Course represents an academic program or degree (e.g. B.Tech Computer Science).
model Course {
  id             String      @id @default(uuid())
  universityId   String?     @map("university_id")
  schoolId       String?     @map("school_id")
  name           String      @db.VarChar(150)
  slug           String      @unique @db.VarChar(150)
  code           String?     @db.VarChar(50)
  degreeLevel    String?     @default("Undergraduate") @map("degree_level") @db.VarChar(50)
  semestersCount Int         @default(8) @map("semesters_count") @db.SmallInt
  description    String?     @db.Text
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relationships
  university     University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  school         School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  users          User[]
  subjects       Subject[]
  notes          Note[]

  @@index([isActive])
  @@index([universityId])
  @@index([schoolId])
  @@map("courses")
}

/// Subject represents an academic course unit or syllabus module (e.g. Data Structures).
model Subject {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  name        String    @db.VarChar(150)
  slug        String    @db.VarChar(150)
  code        String?   @db.VarChar(50)
  description String?   @db.Text
  semester    Int       @db.SmallInt
  credits     Int?      @default(3) @db.SmallInt
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relationships
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  topics      Topic[]
  notes       Note[]

  @@unique([courseId, slug], name: "course_subject_slug_unique")
  @@index([courseId, semester])
  @@index([slug])
  @@index([isActive])
  @@map("subjects")
}

/// Topic represents a granular syllabus concept within a subject.
model Topic {
  id          String    @id @default(uuid())
  subjectId   String    @map("subject_id")
  name        String    @db.VarChar(150)
  slug        String    @db.VarChar(150)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relationships
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  notes       Note[]

  @@unique([subjectId, slug], name: "subject_topic_slug_unique")
  @@index([subjectId])
  @@map("topics")
}

/// Category represents an academic note genre or format (e.g. Lecture Notes, Exam Solutions, Lab Manual).
model Category {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relationships
  notes       Note[]

  @@map("categories")
}

/// Note represents an uploaded study material manuscript or lecture document.
model Note {
  id              String      @id @default(uuid())
  title           String      @db.VarChar(255)
  slug            String?     @db.VarChar(255)
  description     String?     @db.Text
  content         String?     @db.Text
  fileName        String?     @map("file_name") @db.VarChar(255)
  storageKey      String?     @unique @map("storage_key") @db.VarChar(512)
  storageProvider String      @default("local") @map("storage_provider") @db.VarChar(50)
  fileSize        BigInt?     @map("file_size") // In bytes
  mimeType        String?     @default("application/pdf") @map("mime_type") @db.VarChar(100)
  pageCount       Int?        @map("page_count")
  universityId    String?     @map("university_id")
  schoolId        String?     @map("school_id")
  courseId        String      @map("course_id")
  subjectId       String      @map("subject_id")
  topicId         String?     @map("topic_id")
  categoryId      String?     @map("category_id")
  semester        Int?        @db.SmallInt
  academicYear    String?     @map("academic_year") @db.VarChar(20)
  rejectionReason String?     @map("rejection_reason") @db.Text
  uploadedById    String      @map("uploaded_by_id")
  status          NoteStatus  @default(PUBLISHED)
  downloadCount   Int         @default(0) @map("download_count")
  viewCount       Int         @default(0) @map("view_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  publishedAt     DateTime?   @map("published_at")

  // Relationships
  university    University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  school        School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic         Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploadedBy    User        @relation("UserNotes", fields: [uploadedById], references: [id], onDelete: Restrict)
  bookmarks     Bookmark[]
  collectionItems StudyCollectionItem[]
  downloadHistory DownloadHistory[]
  viewHistory     NoteViewHistory[]
  reviews       Review[]
  reports       Report[]

  @@index([status, publishedAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, downloadCount])
  @@index([status, viewCount])
  @@index([status, courseId])
  @@index([status, courseId, semester])
  @@index([status, subjectId])
  @@index([status, subjectId, createdAt(sort: Desc)])
  @@index([status, semester])
  @@index([courseId, subjectId])
  @@index([subjectId, semester])
  @@index([categoryId])
  @@index([uploadedById, status])
  @@index([universityId])
  @@index([schoolId])
  @@index([slug])
  @@index([title])
  @@map("notes")
}

/// Bookmark represents saved notes in a user's study library.
model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  noteId    String   @map("note_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId], name: "user_note_bookmark_unique")
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([noteId])
  @@map("bookmarks")
}

/// Review represents a numerical rating (1-5) and written critique by a student.
model Review {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  noteId    String       @map("note_id")
  rating    Int          @db.SmallInt // 1 to 5 enforced at service & DB layer
  comment   String?      @db.Text
  status    ReviewStatus @default(VISIBLE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relationships
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  note         Note                @relation(fields: [noteId], references: [id], onDelete: Cascade)
  helpfulVotes ReviewHelpfulVote[]
  reports      ReviewReport[]

  @@unique([userId, noteId], name: "user_note_review_unique")
  @@index([noteId])
  @@index([noteId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

/// ReviewHelpfulVote records student votes marking high-quality feedback as helpful.
model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId], name: "review_user_helpful_unique")
  @@index([reviewId])
  @@index([userId])
  @@map("review_helpful_votes")
}

/// ReviewReport tracks student flags on inappropriate, abusive, or spam reviews.
model ReviewReport {
  id           String             @id @default(uuid())
  reviewId     String             @map("review_id")
  reporterId   String             @map("reporter_id")
  reason       ReviewReportReason
  description  String?            @db.Text
  status       ReviewReportStatus @default(OPEN)
  reviewedById String?            @map("reviewed_by_id")
  reviewedAt   DateTime?          @map("reviewed_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  // Relationships
  review       Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter     User               @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?              @relation("ReviewReportModerator", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([reporterId])
  @@index([status])
  @@map("review_reports")
}

/// Report tracks student flags against inappropriate, plagiarized, or low-quality notes.
model Report {
  id           String       @id @default(uuid())
  reportedById String       @map("reported_by_id")
  noteId       String       @map("note_id")
  reason       String       @db.VarChar(255)
  description  String?      @db.Text
  status       ReportStatus @default(PENDING)
  reviewedById String?      @map("reviewed_by_id")
  reviewedAt   DateTime?    @map("reviewed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relationships
  reportedBy   User         @relation("ReportedByUser", fields: [reportedById], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ReviewedByUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  note         Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([noteId])
  @@index([reportedById])
  @@map("reports")
}

/// AuditLog tracks sensitive administrative operations and moderation actions.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relationships
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// RefreshSession tracks active multi-device student sessions and token rotation hashes.
model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// EmailVerificationToken tracks single-use verification links sent to student inboxes.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// PasswordResetToken tracks secure single-use password reset tokens.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// StudyCollection represents a student-curated folder/collection of study notes.
model StudyCollection {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String   @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       StudyCollectionItem[]

  @@unique([userId, name], name: "user_collection_name_unique")
  @@index([userId])
  @@map("study_collections")
}

/// StudyCollectionItem represents the many-to-many relationship between a collection and a note.
model StudyCollectionItem {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  noteId       String   @map("note_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  collection   StudyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  note         Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([collectionId, noteId], name: "collection_note_unique")
  @@index([collectionId])
  @@index([noteId])
  @@map("study_collection_items")
}

/// DownloadHistory records actual note download events for student learning analytics.
model DownloadHistory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  noteId       String   @map("note_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  // Relationships
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, downloadedAt])
  @@index([userId, noteId])
  @@index([noteId])
  @@map("download_history")
}

/// NoteViewHistory tracks genuine note reading events for student learning analytics.
model NoteViewHistory {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  noteId   String   @map("note_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  // Relationships
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([userId, noteId])
  @@index([noteId])
  @@map("note_view_history")
}

// =============================================================================
// NOTIFICATIONS & ACTIVITY CENTER MODELS
// =============================================================================

/// NotificationCategory classifies notifications into high-level user preferences and filters.
enum NotificationCategory {
  ACADEMIC
  REVIEWS
  COMMUNITY
  SYSTEM
  SECURITY
}

/// Notification represents an in-app notice sent to an individual scholar.
model Notification {
  id         String               @id @default(uuid())
  userId     String               @map("user_id")
  type       String               @db.VarChar(60)
  category   NotificationCategory @default(ACADEMIC)
  title      String               @db.VarChar(200)
  message    String               @db.Text
  targetUrl  String?              @map("target_url") @db.VarChar(500)
  isRead     Boolean              @default(false) @map("is_read")
  readAt     DateTime?            @map("read_at")
  eventKey   String?              @unique @map("event_key") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  // Relationships
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, category, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// NotificationPreference tracks a user's delivery preferences for optional notifications.
model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  noteModeration        Boolean  @default(true) @map("note_moderation")
  reviewActivity        Boolean  @default(true) @map("review_activity")
  helpfulVotes          Boolean  @default(true) @map("helpful_votes")
  platformAnnouncements Boolean  @default(true) @map("platform_announcements")
  inAppEnabled          Boolean  @default(true) @map("in_app_enabled")
  emailSecurityAlerts   Boolean  @default(true) @map("email_security_alerts")
  emailNewNotes         Boolean  @default(true) @map("email_new_notes")
  emailAnnouncements     Boolean  @default(true) @map("email_announcements")
  emailLiveActivity      Boolean  @default(true) @map("email_live_activity")
  emailAccountUpdates    Boolean  @default(true) @map("email_account_updates")
  emailWeeklyDigest      Boolean  @default(false) @map("email_weekly_digest")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relationships
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// EmailDeliveryLog records outgoing email messages, statuses, retry counts, and diagnostics.
model EmailDeliveryLog {
  id           String    @id @default(uuid())
  recipient    String    @db.VarChar(255)
  subject      String    @db.VarChar(255)
  templateKey  String?   @map("template_key") @db.VarChar(100)
  status       String    @default("SENT") @db.VarChar(20) // 'SENT', 'FAILED', 'PENDING'
  errorMessage String?   @map("error_message") @db.Text
  attempts     Int       @default(1)
  metadata     Json?
  userId       String?   @map("user_id")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relationships
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([recipient])
  @@index([templateKey])
  @@index([createdAt])
  @@map("email_delivery_logs")
}

/// NotificationTemplate stores customizable operational and marketing email notification templates.
model NotificationTemplate {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  subject     String   @db.VarChar(255)
  htmlBody    String   @map("html_body") @db.Text
  textBody    String?  @map("text_body") @db.Text
  description String?  @db.VarChar(255)
  variables   Json?
  isActive    Boolean  @default(true) @map("is_active")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("notification_templates")
}

/// LiveActivity logs real-time events for scholar and admin activity streams.
model LiveActivity {
  id          String   @id @default(uuid())
  type        String   @db.VarChar(50) // 'NOTE_PUBLISHED', 'NOTE_UPDATED', 'ANNOUNCEMENT_NEW', 'SECURITY_EVENT', 'ADMIN_ACTION'
  action      String   @db.VarChar(100)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  actorId     String?  @map("actor_id")
  actorName   String?  @map("actor_name") @db.VarChar(150)
  actorRole   String?  @map("actor_role") @db.VarChar(50)
  targetId    String?  @map("target_id")
  targetType  String?  @map("target_type") @db.VarChar(50)
  metadata    Json?
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([actorId])
  @@index([isPublic, createdAt])
  @@map("live_activities")
}

/// Announcement stores administrative broadcasts published across the scholar community.
model Announcement {
  id             String    @id @default(uuid())
  createdById    String    @map("created_by_id")
  title          String    @db.VarChar(200)
  message        String    @db.Text
  targetAudience String    @default("ALL") @map("target_audience") @db.VarChar(50)
  targetUrl      String?   @map("target_url") @db.VarChar(500)
  priority       String    @default("NORMAL") @db.VarChar(20)
  publishedAt    DateTime  @default(now()) @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relationships
  createdBy      User      @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([publishedAt])
  @@map("announcements")
}

/// PlatformSetting stores runtime configurable platform parameters governed by Super Admin.
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  category    String   @default("GENERAL") @db.VarChar(50)
  description String?  @db.VarChar(255)
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// =============================================================================
// PLATFORM CONTROL & VISUAL CUSTOMIZATION SUITE
// =============================================================================

/// PageConfiguration stores schema-driven section layouts and content for supported pages.
model PageConfiguration {
  id              String   @id @default(uuid())
  pageKey         String   @unique @map("page_key") @db.VarChar(100) // 'homepage', 'scholar_dashboard', 'admin_dashboard'
  title           String   @db.VarChar(200)
  draftConfig     Json     @map("draft_config")
  publishedConfig Json     @map("published_config")
  version         Int      @default(1)
  updatedById     String?  @map("updated_by_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("page_configurations")
}

/// PlatformTheme stores CSS design token overrides for Public, Scholar, Admin, Super Admin.
model PlatformTheme {
  id              String   @id @default(uuid())
  roleScope       String   @unique @map("role_scope") @db.VarChar(50) // 'PUBLIC', 'SCHOLAR', 'ADMIN', 'SUPER_ADMIN'
  name            String   @db.VarChar(100)
  draftConfig     Json     @map("draft_config")
  publishedConfig Json     @map("published_config")
  version         Int      @default(1)
  updatedById     String?  @map("updated_by_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("platform_themes")
}

/// NavigationConfiguration stores customizable role-based sidebar and navbar hierarchy.
model NavigationConfiguration {
  id              String   @id @default(uuid())
  roleScope       String   @unique @map("role_scope") @db.VarChar(50) // 'SCHOLAR', 'ADMIN', 'SUPER_ADMIN'
  draftConfig     Json     @map("draft_config")
  publishedConfig Json     @map("published_config")
  version         Int      @default(1)
  updatedById     String?  @map("updated_by_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("navigation_configurations")
}

/// FeatureFlag stores database-driven platform feature switches.
model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  category    String   @default("CORE") @db.VarChar(50)
  isEnabled   Boolean  @default(true) @map("is_enabled")
  metadata    Json?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category, isEnabled])
  @@map("feature_flags")
}

/// ContentBlock stores CMS-driven editable texts, announcements, and FAQs.
model ContentBlock {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  section     String   @db.VarChar(100)
  title       String   @db.VarChar(200)
  content     Json
  isPublished Boolean  @default(true) @map("is_published")
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([section, isPublished])
  @@map("content_blocks")
}

/// ConfigurationVersion stores audit snapshots of past configurations for rollback.
model ConfigurationVersion {
  id            String   @id @default(uuid())
  entityType    String   @map("entity_type") @db.VarChar(50) // 'PAGE', 'THEME', 'NAVIGATION', 'FEATURE', 'CONTENT'
  entityKey     String   @map("entity_key") @db.VarChar(100)
  version       Int
  snapshot      Json
  changeSummary String?  @map("change_summary") @db.VarChar(255)
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityKey, version])
  @@map("configuration_versions")
}

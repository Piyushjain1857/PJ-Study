# ==============================================================================
# PJ STUDY BACKEND ENVIRONMENT SPECIFICATION
# Safe production blueprint without hardcoded secrets
# ==============================================================================

# Server Environment
PORT=5001
NODE_ENV=production
DATABASE_URL="mysql://pj_user:STRONG_SECURE_PASSWORD@127.0.0.1:3306/pj_study?schema=public&sslmode=prefer"
FRONTEND_URL=https://pjstudy.com
PUBLIC_APP_URL=https://pjstudy.com

# Cryptographic Token & Session Configuration (Min 32 characters required)
JWT_ACCESS_SECRET=replace_with_entropy_rich_cryptographic_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# File Storage Architecture (Local volume or S3-compatible backend)
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/data/pjstudy/uploads/notes
MAX_FILE_SIZE_MB=25

# Transactional Email Service (console | smtp | sendgrid | resend)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@pjstudy.com
EMAIL_API_KEY=

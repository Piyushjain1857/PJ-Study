# Server Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/pj_study"
FRONTEND_URL=http://localhost:5173

# Authentication & Session Security
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_random
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# Email Service (console | smtp | resend)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@pjstudy.com
EMAIL_API_KEY=

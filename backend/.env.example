# ==============================================================================
# PJ STUDY BACKEND ENVIRONMENT SPECIFICATION
# Safe production blueprint without hardcoded secrets
# ==============================================================================

# Server Environment
PORT=5001
NODE_ENV=production
# PostgreSQL Database Connection (Render, Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://pj_user:STRONG_SECURE_PASSWORD@localhost:5432/pj_study?schema=public&sslmode=prefer"
# Legacy MySQL connection format (for reference during transition only)
# DATABASE_URL="mysql://pj_user:STRONG_SECURE_PASSWORD@127.0.0.1:3306/pj_study"
FRONTEND_URL=https://pjstudy.com
PUBLIC_APP_URL=https://pjstudy.com

# Cryptographic Token & Session Configuration (Min 32 characters required)
JWT_ACCESS_SECRET=replace_with_entropy_rich_cryptographic_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# File Storage Architecture (local | google_drive | s3)
STORAGE_PROVIDER=google_drive
UPLOAD_DIR=/var/data/pjstudy/uploads/notes
MAX_FILE_SIZE_MB=25

# Google Drive Cloud Storage Configuration (Private Dedicated Notes Backend)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_dedicated_private_folder_id_from_google_drive
GOOGLE_REDIRECT_URI=http://localhost:5001/api/v1/storage/google/oauth/callback

# Transactional Email Service & SMTP (console | smtp | sendgrid | resend)
EMAIL_PROVIDER=smtp
EMAIL_FROM="PJ Study <noreply@pjstudy.com>"
EMAIL_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_or_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_SECURE=false

# Swagger UI Documentation (Disabled by default in production; set to true to enable)
ENABLE_SWAGGER=false
# Optional access key header required in production when enabled: X-Swagger-Key
SWAGGER_KEY=your_optional_secret_swagger_access_key

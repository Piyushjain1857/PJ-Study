{
  "name": "pj-study-backend",
  "version": "1.0.0",
  "description": "Backend API for PJ Study platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js --confirm-seed",
    "seed": "node prisma/seed.js --confirm-seed",
    "seed:core": "node prisma/seed.js --mode=core --confirm-seed",
    "seed:fresh": "node prisma/seed.js --mode=core --confirm-seed",
    "seed:reset": "node prisma/seed.js --mode=core --confirm-seed",
    "seed:demo": "node prisma/seed.js --mode=demo --confirm-seed",
    "seed:full": "node prisma/seed.js --mode=full --confirm-seed",
    "seed:verify": "node prisma/seed.js --verify",
    "seed:dry-run": "node prisma/seed.js --dry-run",
    "gdrive:auth": "node scripts/gdrive-auth.js",
    "db:backup": "node scripts/backup-mysql.js",
    "db:migrate:postgres": "node scripts/migrate-mysql-to-postgres.js",
    "db:verify": "node scripts/verify-migration-integrity.js",
    "db:cutover": "node scripts/cutover-to-postgres.js",
    "db:rollback": "node scripts/rollback-to-mysql.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "googleapis": "^190.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  },
  "keywords": [
    "express",
    "prisma",
    "mysql",
    "api"
  ],
  "author": "PJ Study Team",
  "license": "ISC"
}

# ==============================================================================
# PJ STUDY FRONTEND CLIENT ENVIRONMENT SPECIFICATION
# Only variables prefixed with VITE_ are exposed to the browser bundle
# NEVER place secret tokens or private keys in this file
# ==============================================================================

# Backend API v1 Base URL
VITE_API_BASE_URL=https://api.pjstudy.com/api/v1

# Public Application Canonical URL (Used for Canonical Meta, Open Graph & Sitemaps)
VITE_PUBLIC_APP_URL=https://pjstudy.com

# PJ Study Monorepo Environment Configuration Reference

# Backend API Configuration
PORT=5001
NODE_ENV=production
# PostgreSQL Connection String (Render PostgreSQL, Supabase, Neon, AWS RDS, or local)
DATABASE_URL="postgresql://pj_user:STRONG_SECURE_PASSWORD@localhost:5432/pj_study?schema=public&sslmode=prefer"
FRONTEND_URL=https://pjstudy.com
PUBLIC_APP_URL=https://pjstudy.com

# Authentication Security Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_random
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# File Storage Architecture (google_drive | local)
STORAGE_PROVIDER=google_drive
MAX_FILE_SIZE_MB=25
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_dedicated_private_folder_id_from_google_drive
GOOGLE_REDIRECT_URI=https://pj-study-backend.onrender.com/api/v1/storage/google/oauth/callback

# Email Provider Configuration (console | smtp | resend)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@pjstudy.com
EMAIL_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1

